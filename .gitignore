# Aturan tingkat repo. Aturan khusus Next.js ada di frontend/.gitignore.

# OS
.DS_Store
Thumbs.db
desktop.ini

# editor
.vscode/
.idea/
*.swp
*~

# log & berkas sementara
*.log
*.tmp

# Dokumen sumber (SRS, user flow) yang tersimpan di root — lihat README.
# Sengaja dibatasi ke root pakai awalan "/": juknis PDF yang nanti diunggah ke
# frontend/public/ harus tetap bisa di-commit, karena modal lomba punya tombol
# "Unduh juknis" yang merujuk ke sana.
/*.docx
/*.pdf
~$*
